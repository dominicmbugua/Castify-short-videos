# Castify Shorts Pipeline — Development Environment

# FastAPI
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_RELOAD=true
FASTAPI_DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=castify
DB_PASSWORD=castify_dev_password
DB_NAME=castify_shorts_dev
DATABASE_URL=postgresql://castify:castify_dev_password@localhost:5432/castify_shorts_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# S3 / MinIO
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_dev
S3_BUCKET=castify-dev
S3_REGION=us-east-1

# Google Drive API (fill in by Castify team)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Email (fill in by Castify team)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
SENDER_EMAIL=noreply@castify.ai

# Limits
MAX_CONCURRENT_SUBMISSIONS_PER_EMAIL=3
MAX_SINGLE_VIDEO_SIZE_GB=2
MAX_ZIP_SIZE_GB=5
MAX_VIDEOS_PER_ZIP=20
MAX_VIDEO_DURATION_MINUTES=90

# Logging
LOG_LEVEL=INFO